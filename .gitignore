# ======================================================
# React + TypeScript + Vite + VS Code 專案最佳化 .gitignore
# ======================================================

# -------------------------------
# VS Code 個人設定
.vscode/
.vscode/launch.json

# -------------------------------
# Node.js 套件
node_modules/

# -------------------------------
# TypeScript / Vite 編譯輸出
dist/
build/
out/
dist-ssr/

# -------------------------------
# 測試快取與覆蓋率報告
coverage/
.nyc_output/
.vitest/
.cypress_cache/

# -------------------------------
# 環境變數檔案（避免洩漏金鑰）
.env
*.env

# -------------------------------
# 日誌與偵錯紀錄
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -------------------------------
# 系統暫存檔
.DS_Store
Thumbs.db

# -------------------------------
# Editor / IDE 設定檔
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# -------------------------------
# 可視化筆記（選擇性忽略）
Notes.txt

# -------------------------------
# 鎖定檔案（建議保留版本一致性）
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
