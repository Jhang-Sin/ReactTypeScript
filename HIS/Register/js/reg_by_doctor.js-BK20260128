/**
 * reg_by_doctor.js
 * -------------------------------------------------
 * 依醫師掛號頁（Phase 1）
 * - 使用 reg_base.js
 * - router.js 負責 unmount
 * - 本檔案不可宣告全域 const / let
 * -2026-01-16
* - Vue App 由 router.js 負責 unmount / remount
 * - 本檔案不可自行判斷是否已存在 Vue instance
 */

console.log("[reg_by_doctor] script loaded");

// ==================================================
// 🚧【最外層保護殼】IIFE（避免全域污染）
// ==================================================
(() => {

 
// ==================================================
// 🛡 Guard：避免重複 mount（但允許重建）
// ==================================================

//20260116-修正START不使用下列判斷-page JS 再做 guard = 兩個指揮官互相打架
// if (window.__vue_app__) {
//   console.warn("[reg_by_doctor] Vue app already exists, skip mount");
//   return;
// }
//20260116-修正END

  // ==================================================
  // 建立 Vue App（不可用 const 宣告在全域）
  // ==================================================
  const app = createRegBaseApp({     ////從vueApp改成app -20260116
    pageName: "reg_by_doctor",

    /* =================================================
     * 1️⃣【流程】初始化（init）
     * ================================================= */
    extendMounted() {
      console.log("[1:init] start");

      this.IniFlag = 0;

      // ✔ 與 HTML 對齊的資料名稱
      this.doctors = [];
      this.schedules = [];     // ← 補20260116
      this.scheduleList = [];

      this.selectedDoctorId = "";

      console.log("[1:init] done");

      // 推進流程
      this.GetData();   // 👉【流程】
    },

    extendMethods: {

      /* =================================================
       * 2️⃣【流程】取得資料
       * ================================================= */
      GetData() {
        console.log("[2:GetData] start");

        // reg_base.js 已載入的資料
        this.doctors = Array.isArray(this.doctorList)
          ? this.doctorList
          : [];

        this.schedules = Array.isArray(this.scheduleRaw)
          ? this.scheduleRaw
          : [];

        console.log("[2:GetData] result", {
          doctorCount: this.doctors.length,
          scheduleCount: this.schedules.length
        });

        this.DataSetInView();   // 👉【流程】
      },

      /* =================================================
       * 3️⃣【流程】資料綁定完成
       * ================================================= */
      DataSetInView() {
        console.log("[3:DataSetInView] start");

        // 尚未選醫師，清空結果
        this.scheduleList = [];

        this.initFinish();   // 👉【流程】
      },

      /* =================================================
       * 4️⃣【流程】初始化完成
       * ================================================= */
      initFinish() {
        console.log("[4:initFinish] done");
        this.IniFlag = 1;
      },

      /* =================================================
       * 👉【事件】使用者選擇醫師
       * ================================================= */
      loadSchedule() {
        console.log("[event:loadSchedule]");

        if (!this.selectedDoctorId) {
          this.scheduleList = [];
          return;
        }

        this.scheduleList = this.schedules
          .filter(s => s.status === 1)
          .filter(s => s.doctorId === this.selectedDoctorId)
          .map(s => this.joinSchedule(s))
          .filter(Boolean);
      },

      /* =================================================
       * 👉【工具】資料 JOIN
       * ================================================= */
      joinSchedule(s) {
        const doctor = this.doctors.find(
          d => d.doctorId === s.doctorId
        );
        if (!doctor) return null;

        return {
          ...s,
          doctorName: doctor.doctorName,
          depName: this.depMap[s.depCode]?.zh || "",
          noonLabel: this.noonMap[s.noon]?.label || s.noon
        };
      },

      /* =================================================
       * 👉【事件】掛號
       * ================================================= */
      register(item) {
        alert(`掛號成功\n醫師：${item.doctorName}\n日期：${item.date}`);
      }
    }
  });

  // ==================================================
  // 🚩 統一出口（router.js 會 unmount）
  // ==================================================
  ////window.__vue_app__ = app.mount("#app"); ////vueApp改成app=>修正成下面這兩行

app.mount("#app");
// 🚩 一定要存「App instance」
window.__vue_app__ = app;

  console.log("[reg_by_doctor] mounted");
  console.log("doc-js-20260116");

})();
