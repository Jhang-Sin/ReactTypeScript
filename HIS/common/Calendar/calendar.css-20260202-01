/* ===============================
   Calendar 主容器
   =============================== */
.his-calendar {
  font-family: Arial, system-ui, -apple-system, BlinkMacSystemFont;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  user-select: none;
}

/* ===============================
   Header（月切換 / Today）
   =============================== */
.his-calendar__header {
  margin-bottom: 8px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12px;
}

/* ===============================
   Calendar Table（⚠️ 關鍵修正）
   =============================== */
.his-calendar__table {
  width: 100%;
  table-layout: fixed;        /* ⭐ 防止橫向爆版 */
  border-collapse: collapse;
}

/* ===============================
   日期格子（td）
   =============================== */
.his-calendar__cell {
  border: 1px solid #ccc;
  width: calc(100% / 7);      /* ⭐ 一列 7 天 */
  height: 72px;
  vertical-align: top;
  padding: 6px;
  box-sizing: border-box;
  cursor: pointer;
  background: #fff;

  transition:
    background-color 0.15s ease,
    border-color 0.15s ease,
    box-shadow 0.15s ease;
}

/* ===============================
   Hover 提示（讓使用者知道「可以點」）
   =============================== */
.his-calendar__cell:hover {
  background: #e9f5ff;
  border-color: #409eff;
}

/* ===============================
   Today 樣式
   =============================== */
.his-calendar__cell.is-today {
  outline: 2px solid #4caf50;
  background: #ecf8ec;
  font-weight: 600;
}

/* ===============================
   被點選的日期（焦點）
   =============================== */
.his-calendar__cell.is-selected {
  background: #409eff;
  color: #fff;
  border-color: #409eff;
  box-shadow: inset 0 0 0 2px rgba(64, 158, 255, 0.35);
}

/* ===============================
   無效日期 / 無門診
   =============================== */
.his-calendar__cell.is-disabled {
  background: #eee;
  opacity: 0.5;
  cursor: not-allowed;
  pointer-events: none;
}

/* =====================================================
   ↓↓↓ 以下為「舊版 grid calendar」樣式（保留註解）
   ⚠️ 目前 renderer 未使用，不會生效
   ===================================================== */

/*Hover 提示（讓使用者知道「可以點」）*/
.calendar-day:hover {  
  background: #e9f5ff;
  border-color: #409eff;
}

/*Today 樣式*/
.calendar-day.today {
  border: 2px solid #4caf50;
  background: #ecf8ec;
  font-weight: 600;
}

/*「被點選的日期」焦點樣式*/
.calendar-day.active {
  background: #409eff;
  color: #fff;
  border-color: #409eff;
  box-shadow: 0 0 0 2px rgba(64, 158, 255, 0.3);
}

/*星期列（W1 ~ W7）*/
.calendar-week {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 4px;
  font-size: 12px;
  color: #666;
}

.calendar-week div {
  text-align: center;
}

/*無效日期 / 無門診（未來擴充）*/
.calendar-day.disabled {
  background: #f0f0f0;
  color: #aaa;
  cursor: not-allowed;
  pointer-events: none;
}

.calendar-body {
  display: grid;
  grid-template-columns: repeat(7, 1fr); /* 7 天一列 */
  gap: 6px;
  width: 100%;
  max-width: 420px;
  margin: 0 auto;
}

.calendar-day {
  height: 42px;
  line-height: 42px;
  text-align: center;
  cursor: pointer;
  user-select: none;
  border-radius: 6px;
  background: #f7f7f7;
  border: 1px solid #ddd;
}
